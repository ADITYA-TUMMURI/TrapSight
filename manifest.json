{
  "manifest_version": 3,
  "name": "TrapSight",
  "version": "1.0.0",
  "description": "Chrome extension utilizing Gemini 1.5 Flash to identify dark patterns and hidden fees on checkout pages.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
