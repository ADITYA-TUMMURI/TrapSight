{
  "manifest_version": 3,
  "name": "TrustGuard (TrapSight)",
  "version": "1.0.0",
  "description": "Just-in-time protection from predatory subscriptions using Gemini 1.5 Flash.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://www.namecheap.com/*",
    "https://www.adobe.com/*",
    "https://*.myshopify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.namecheap.com/*",
        "https://*.adobe.com/*",
        "https://*.myshopify.com/*"
      ],
      "js": ["widget/widget.js", "scraper.js", "content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
